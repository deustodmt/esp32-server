# Copy this file to .env and adjust values for your local machine.
# Do not commit real secrets.

# Mosquitto
MOSQUITTO_EXTERNAL_PORT=2000
MOSQUITTO_INTERNAL_PORT=1883

# Python MQTT client
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_TOPIC=test_topic
MQTT_CLIENT_ID=

# InfluxDB setup
INFLUXDB_EXTERNAL_PORT=8086
INFLUXDB_INTERNAL_PORT=8086
INFLUXDB_USERNAME=admin
INFLUXDB_PASSWORD=change-me-local-password
INFLUXDB_ORG=deusto
INFLUXDB_BUCKET=udmt
INFLUXDB_TOKEN=change-me-local-token

# Python server
INFLUXDB_URL=http://db:8086
